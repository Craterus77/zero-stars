# Leave unset for local SQLite. Inject secrets through your process/Vercel settings.
# Copy the transaction pooler connection string from your Supabase project's Connect panel.
DATABASE_URL=
# Alternative Vercel/Supabase integration names also supported by the backend.
POSTGRES_URL=
SUPABASE_DB_URL=
# Optional project CA certificate PEM; TLS verification is always enabled remotely.
SUPABASE_CA_CERT=
# Comma-separated email addresses granted moderation rights at register/login.
MOD_EMAILS=
# Optional disposable Postgres integration-test target (never production).
TEST_DATABASE_URL=

# Optional Supabase JS/SSR settings. These public values do not replace DATABASE_URL.
# Express does not automatically load .env.local or expose NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
